from __future__ import annotations
import collections.abc
import numpy
import numpy.typing
import typing

__all__: list[str] = [
    "Game",
    "MATE_BOUND",
    "MCTS",
    "N_PAWN_ACTIONS",
    "N_PLANES",
    "SearchResult",
    "Searcher",
    "WIN",
    "batch_features",
]

class Game:
    def __copy__(self) -> Game: ...
    def __deepcopy__(self, arg0: dict) -> Game: ...
    def __init__(
        self,
        width: typing.SupportsInt | typing.SupportsIndex = 9,
        height: typing.SupportsInt | typing.SupportsIndex = 9,
        walls: typing.SupportsInt | typing.SupportsIndex = 10,
        max_plies: typing.SupportsInt | typing.SupportsIndex = 0,
    ) -> None: ...
    def __str__(self) -> str: ...
    def apply(self, action: typing.SupportsInt | typing.SupportsIndex) -> None: ...
    def clone(self) -> Game: ...
    def describe_action(
        self, action: typing.SupportsInt | typing.SupportsIndex
    ) -> tuple[str, int, int]: ...
    def distance(self, player: typing.SupportsInt | typing.SupportsIndex) -> int: ...
    def features(self) -> numpy.typing.NDArray[numpy.float32]: ...
    def hash(self) -> int: ...
    def is_terminal(self) -> bool: ...
    def legal_actions(self) -> list[int]: ...
    def legal_mask(self) -> numpy.typing.NDArray[numpy.uint8]: ...
    def mirror_action(
        self, action: typing.SupportsInt | typing.SupportsIndex
    ) -> int: ...
    def winner(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def max_plies(self) -> int: ...
    @property
    def num_actions(self) -> int: ...
    @property
    def pawns(self) -> tuple[tuple[int, int], tuple[int, int]]: ...
    @property
    def ply(self) -> int: ...
    @property
    def side(self) -> int: ...
    @property
    def walls(self) -> list[tuple[str, int, int]]: ...
    @property
    def walls_left(self) -> tuple[int, int]: ...
    @property
    def width(self) -> int: ...

class SearchResult:
    def __repr__(self) -> str: ...
    @property
    def action(self) -> int: ...
    @property
    def depth(self) -> int: ...
    @property
    def nodes(self) -> int: ...
    @property
    def score(self) -> int: ...

class Searcher:
    def __init__(
        self, tt_mb: typing.SupportsInt | typing.SupportsIndex = 64
    ) -> None: ...
    def clear(self) -> None: ...
    def evaluate(self, game: Game) -> int: ...
    def search(
        self,
        game: Game,
        max_depth: typing.SupportsInt | typing.SupportsIndex = 64,
        time_ms: typing.SupportsInt | typing.SupportsIndex = 1000,
    ) -> SearchResult: ...
    @property
    def wall_weight(self) -> int: ...
    @wall_weight.setter
    def wall_weight(self, arg0: typing.SupportsInt | typing.SupportsIndex) -> None: ...

class MCTS:
    def __init__(
        self,
        sims: typing.SupportsInt | typing.SupportsIndex = 64,
        max_considered: typing.SupportsInt | typing.SupportsIndex = 16,
        c_puct: typing.SupportsFloat | typing.SupportsIndex = 1.25,
        seed: typing.SupportsInt | typing.SupportsIndex = 0,
    ) -> None: ...
    def actions(self) -> list[int]: ...
    def feed(
        self,
        logits: typing.Annotated[numpy.typing.ArrayLike, numpy.float32],
        values: typing.Annotated[numpy.typing.ArrayLike, numpy.float32],
    ) -> None: ...
    def leaf_features(self) -> numpy.typing.NDArray[numpy.float32]: ...
    def policies(self) -> numpy.typing.NDArray[numpy.float32]: ...
    def raw_values(self) -> list[float]: ...
    def root_values(self) -> list[float]: ...
    def start(
        self, games: collections.abc.Sequence[Game], noise: bool = False
    ) -> None: ...
    def visits(
        self, index: typing.SupportsInt | typing.SupportsIndex
    ) -> list[tuple[int, int]]: ...

def batch_features(
    games: collections.abc.Sequence[Game],
) -> numpy.typing.NDArray[numpy.float32]: ...

MATE_BOUND: int = 990000
N_PAWN_ACTIONS: int = 12
N_PLANES: int = 8
WIN: int = 1000000
